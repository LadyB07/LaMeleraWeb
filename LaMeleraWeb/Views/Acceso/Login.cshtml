@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acceso - Sistema Gestión Cortijo La Melera</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        :root {
            --olivo-oscuro: #3d4f22;
            --olivo-principal: #556b2f;
            --olivo-claro: #748c42;
            --crema-fondo: #f4f6ef;
            --dorado-acento: #c59b27;
        }

        body {
            background: linear-gradient(135deg, var(--crema-fondo) 0%, #e4ebd6 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .login-card {
            background: #ffffff;
            border-radius: 18px;
            box-shadow: 0 12px 35px rgba(61, 79, 34, 0.18);
            overflow: hidden;
            max-width: 860px;
            width: 95%;
            border: 2px solid var(--olivo-principal);
        }

        .logo-side {
            background-color: var(--olivo-principal);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            color: #fff;
            text-align: center;
        }

            .logo-side img {
                width: 210px;
                height: 210px;
                object-fit: cover;
                border-radius: 50%;
                border: 4px solid var(--dorado-acento);
                box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
                background: #fff;
            }

        .form-side {
            padding: 3rem 2.5rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .titulo-melera {
            color: var(--olivo-oscuro);
            font-weight: 700;
            letter-spacing: 0.5px;
            border-bottom: 2px solid var(--dorado-acento);
            padding-bottom: 0.6rem;
            margin-bottom: 1.5rem;
        }

        .form-label {
            color: var(--olivo-oscuro);
            font-weight: 600;
        }

        .form-control:focus {
            border-color: var(--olivo-principal);
            box-shadow: 0 0 0 0.2rem rgba(85, 107, 47, 0.25);
        }

        .btn-olivo {
            background-color: var(--olivo-principal);
            color: white;
            font-weight: 600;
            border: none;
            padding: 0.65rem 1.5rem;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .btn-olivo:hover {
            background-color: var(--olivo-oscuro);
            color: #fff;
            transform: translateY(-1px);
        }
    </style>
</head>
<body>
    <div class="login-card row g-0">
        <div class="col-md-5 logo-side">
            <img src="~/img/logo-melera.jpg" alt="Logo Cortijo La Melera" />
            <h5 class="mt-3 mb-0 fw-bold">Comunidad La Melera</h5>
            <small class="opacity-75">Sierra Arana · Iznalloz</small>
        </div>

        <div class="col-md-7 form-side">
            <h4 class="titulo-melera">SISTEMA DE GESTIÓN OLIVAR</h4>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2" role="alert">
                    @ViewBag.Error
                </div>
            }

            <form asp-controller="Acceso" asp-action="Login" method="post">
                <div class="mb-3">
                    <label for="nombreUsuario" class="form-label">USUARIO</label>
                    <input type="text" class="form-control form-control-lg" id="nombreUsuario" name="nombreUsuario" placeholder="Ej: admin" required autofocus />
                </div>

                <div class="mb-4">
                    <label for="clave" class="form-label">CONTRASEÑA</label>
                    <input type="password" class="form-control form-control-lg" id="clave" name="clave" placeholder="••••••••" required />
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-olivo btn-lg">Ingresar al Sistema</button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>