@model LaMeleraWeb.Models.IngresoComunidad
@{
    ViewData["Title"] = "Ingresos Comunidad";
    var comuneros = ViewBag.Comuneros as List<LaMeleraWeb.Models.Comunero>;
    var conceptos = ViewBag.Conceptos as List<LaMeleraWeb.Models.Concepto>;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-olivo p-4">
            <h4 class="fw-bold mb-3" style="color: #3d4f22; border-bottom: 2px solid #c59b27; padding-bottom: 8px;">
                Registrar Ingreso - Comunidad
            </h4>

            <form asp-action="IngresosComunidad" method="post">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Fecha de Registro</label>
                        <input asp-for="Fecha" type="date" class="form-control" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Concepto</label>
                        <select asp-for="IdConcepto" class="form-select" required>
                            @foreach (var c in conceptos!)
                            {
                                <option value="@c.IdConcepto">@c.NombreConcepto</option>
                            }
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">Comunero que Aporta</label>
                        <select asp-for="IdComunero" class="form-select" required>
                            <option value="">-- Seleccione un comunero --</option>
                            @foreach (var com in comuneros!)
                            {
                                <option value="@com.IdComunero">@com.NombreCompleto</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Mes de Cuota</label>
                        <select asp-for="PeriodoMes" class="form-select">
                            <option value="">(No aplica / Extraordinaria)</option>
                            <option value="1">Enero</option>
                            <option value="2">Febrero</option>
                            <option value="3">Marzo</option>
                            <option value="4">Abril</option>
                            <option value="5">Mayo</option>
                            <option value="6">Junio</option>
                            <option value="7">Julio</option>
                            <option value="8">Agosto</option>
                            <option value="9">Septiembre</option>
                            <option value="10">Octubre</option>
                            <option value="11">Noviembre</option>
                            <option value="12">Diciembre</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Año de Cuota</label>
                        <input asp-for="PeriodoAnio" type="number" min="1980" max="2100" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Importe (€)</label>
                        <input asp-for="Importe" type="number" step="0.01" class="form-control fw-bold text-success" required />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">Observaciones / Notas</label>
                        <textarea asp-for="Notas" class="form-control" rows="2" placeholder="Opcional..."></textarea>
                    </div>
                </div>

                <div class="mt-4 d-flex justify-content-end gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-olivo px-4">Guardar Ingreso</button>
                </div>
            </form>
        </div>
    </div>
</div>