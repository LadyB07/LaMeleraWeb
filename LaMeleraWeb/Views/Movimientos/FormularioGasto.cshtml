@model LaMeleraWeb.Models.GastoGeneral
@{
    ViewData["Title"] = ViewBag.Titulo;
    var conceptos = ViewBag.Conceptos as List<LaMeleraWeb.Models.Concepto>;
    string accionDestino = (bool)ViewBag.EsOlivar ? "GastosOlivar" : "GastosComunes";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-olivo p-4" style="border-top-color: #b03a2e;">
            <h4 class="fw-bold mb-3" style="color: var(--olivo-oscuro); border-bottom: 2px solid #c59b27; padding-bottom: 8px;">
                @ViewBag.Titulo
            </h4>

            <form id="formGasto" asp-action="@accionDestino" method="post" enctype="multipart/form-data">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Fecha del Gasto</label>
                        <input asp-for="Fecha" type="date" class="form-control" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Concepto</label>
                        <select asp-for="IdConcepto" class="form-select" required>
                            <option value="">-- Seleccione concepto --</option>
                            @foreach (var c in conceptos!)
                            {
                                <option value="@c.IdConcepto">@c.NombreConcepto</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Nro. Factura / Recibo</label>
                        <input asp-for="NroFacturaRecibo" type="text" class="form-control" placeholder="Ej: FAC-2026-01" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold text-primary">Litros (Opcional)</label>
                        <input asp-for="Litros" type="number" step="0.01" class="form-control" placeholder="0.00" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Importe Total (€)</label>
                        <input asp-for="Importe" id="inpImporteGasto" type="number" step="0.01" class="form-control fw-bold text-danger" required />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">📎 Adjuntar Factura o Ticket (PDF / Foto - Opcional)</label>
                        <input type="file" name="archivoComprobante" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.webp" />
                        <small class="text-muted">Permite a los comuneros visualizar el respaldo del gasto desde Reportes.</small>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">Observaciones / Notas</label>
                        <textarea asp-for="Notas" class="form-control" rows="2" placeholder="Detalle del proveedor o trabajo realizado..."></textarea>
                    </div>
                </div>

                <div class="mt-4 d-flex justify-content-end gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="button" class="btn btn-danger px-4" onclick="confirmarGuardadoGasto()">Guardar Gasto</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal de Confirmación Elegante -->
<div class="modal fade" id="modalConfirmarGasto" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold">Confirmar Registro de Gasto</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1">¿Estás seguro de registrar este gasto por un importe de <strong id="lblMontoConfirmar" class="text-danger">0.00 €</strong>?</p>
                <small class="text-muted">Se descontará inmediatamente del saldo general de la comunidad.</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Revisar</button>
                <button type="button" class="btn btn-danger fw-bold" onclick="document.getElementById('formGasto').submit()">Sí, Registrar Gasto</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmarGuardadoGasto() {
            const form = document.getElementById("formGasto");
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }
            const monto = parseFloat(document.getElementById("inpImporteGasto").value) || 0;
            document.getElementById("lblMontoConfirmar").textContent = monto.toFixed(2) + " €";
            new bootstrap.Modal(document.getElementById("modalConfirmarGasto")).show();
        }
    </script>
}