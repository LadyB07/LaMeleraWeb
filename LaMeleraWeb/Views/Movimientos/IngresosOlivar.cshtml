@model LaMeleraWeb.Models.IngresoOlivar
@{
    ViewData["Title"] = "Ingresos Olivar";
    var conceptos = ViewBag.Conceptos as List<LaMeleraWeb.Models.Concepto>;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-olivo p-4">
            <h4 class="fw-bold mb-3" style="color: var(--olivo-oscuro); border-bottom: 2px solid #c59b27; padding-bottom: 8px;">
                Registrar Ingreso - Olivar y Cosecha
            </h4>

            <form asp-action="IngresosOlivar" method="post">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Fecha</label>
                        <input asp-for="Fecha" type="date" class="form-control" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Concepto</label>
                        <select asp-for="IdConcepto" class="form-select" required>
                            @foreach (var c in conceptos!)
                            {
                                <option value="@c.IdConcepto">@c.NombreConcepto</option>
                            }
                        </select>
                    </div>

                    <!-- Campo separado para ACEITUNA (Siempre visible) -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-success">🫒 Kg de Aceituna</label>
                        <input asp-for="KgAceituna" id="kgAceituna" type="number" step="0.01" class="form-control" placeholder="0.00" oninput="calcularTotal()" />
                    </div>

                    <!-- Campo separado para ACEITE (Siempre visible) -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-warning-emphasis">🧴 Kg / Litros de Aceite</label>
                        <input asp-for="KgAceite" id="kgAceite" type="number" step="0.01" class="form-control" placeholder="0.00" oninput="calcularTotal()" />
                    </div>

                    <!-- Precio unitario aplicable a cualquiera de los dos (Siempre visible) -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Precio por Kg / L (€)</label>
                        <input asp-for="PrecioPorKg" id="precioKg" type="number" step="0.001" class="form-control" placeholder="0.000" oninput="calcularTotal()" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Importe Total Cobrado (€)</label>
                        <input asp-for="Importe" id="importeTotal" type="number" step="0.01" class="form-control fw-bold text-success" required />
                        <small class="text-muted">Se calcula automático al poner cantidad y precio, o escríbelo directo (ej. Subvenciones).</small>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Observaciones / Comunero / Campaña</label>
                        <input asp-for="Notas" type="text" class="form-control" placeholder="Ej: Julio - 70 lts aceite a 4,50 €" />
                    </div>
                </div>

                <div class="mt-4 d-flex justify-content-end gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-olivo px-4">Guardar Ingreso</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function calcularTotal() {
            const kgAceituna = parseFloat(document.getElementById("kgAceituna").value) || 0;
            const kgAceite = parseFloat(document.getElementById("kgAceite").value) || 0;
            const precio = parseFloat(document.getElementById("precioKg").value) || 0;
            const elTotal = document.getElementById("importeTotal");

            const cantidad = kgAceituna > 0 ? kgAceituna : kgAceite;
            if (cantidad > 0 && precio > 0 && elTotal) {
                elTotal.value = (cantidad * precio).toFixed(2);
            }
        }
    </script>
}