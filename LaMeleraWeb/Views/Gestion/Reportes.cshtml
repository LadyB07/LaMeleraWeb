@model List<LaMeleraWeb.Models.MovimientoReporte>
@{
    ViewData["Title"] = "Informes de Gestión";
    var conceptos = ViewBag.Conceptos as List<LaMeleraWeb.Models.Concepto>;
    int? idApartado = ViewBag.IdApartado;
    int? idConcepto = ViewBag.IdConcepto;
    bool esSoloConsulta = Context.Session.GetString("Rol") == "Consulta";
}

<style>
    @@media print {
        @@page {
            size: landscape;
            margin: 8mm;
        }

        .no-print, header, nav, footer {
            display: none !important;
        }

        body {
            background: #fff !important;
        }

        .card {
            box-shadow: none !important;
            border: 1px solid #ccc !important;
        }

        .table-responsive {
            overflow: visible !important;
        }

        table {
            width: 100% !important;
            table-layout: fixed;
            font-size: 8.5pt !important;
        }

        th, td {
            padding: 4px 5px !important;
            word-wrap: break-word;
            overflow-wrap: break-word;
        }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-0" style="color: var(--olivo-oscuro);">Informes de Gestión y Libro Diario</h3>
        <small class="text-muted">Del @DateTime.Parse((string)ViewBag.FechaInicio).ToString("dd/MM/yyyy") al @DateTime.Parse((string)ViewBag.FechaFin).ToString("dd/MM/yyyy")</small>
    </div>
    <div class="d-flex gap-2 no-print">
        <button type="button" onclick="exportarTablaExcel()" class="btn btn-success">📊 Exportar a Excel</button>
        <button type="button" onclick="window.print()" class="btn btn-olivo">🖨️ Imprimir / Guardar PDF</button>
    </div>
</div>

<!-- Panel de Filtros (Oculto al imprimir PDF) -->
<div class="card card-olivo p-3 mb-4 no-print">
    <form method="get" asp-action="Reportes" class="row g-2 align-items-end">
        <div class="col-md-2">
            <label class="form-label small fw-bold">Desde</label>
            <input type="date" name="fechaInicio" value="@ViewBag.FechaInicio" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-bold">Hasta</label>
            <input type="date" name="fechaFin" value="@ViewBag.FechaFin" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-bold">Apartado</label>
            <select name="idApartado" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">-- Todos los Apartados --</option>
                <option value="1" selected="@(idApartado == 1)">Ingresos Comunidad</option>
                <option value="2" selected="@(idApartado == 2)">Gastos Zonas Comunes</option>
                <option value="3" selected="@(idApartado == 3)">Ingresos Olivar</option>
                <option value="4" selected="@(idApartado == 4)">Gastos Olivar</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-bold">Concepto Específico</label>
            <select name="idConcepto" class="form-select form-select-sm" @(idApartado == null ? "disabled" : "")>
                <option value="">-- Todos los Conceptos --</option>
                @if (conceptos != null)
                {
                    foreach (var c in conceptos)
                    {
                        <option value="@c.IdConcepto" selected="@(idConcepto == c.IdConcepto)">@c.NombreConcepto</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-olivo btn-sm">Filtrar Datos</button>
        </div>
    </form>
</div>

<!-- Resumen del Periodo Consultado -->
<div class="row g-3 mb-4">
    <div class="col-4">
        <div class="card p-3 border-start border-success border-4">
            <small class="text-muted fw-bold">INGRESOS DEL PERIODO</small>
            <h4 class="text-success fw-bold mb-0">@(((decimal)ViewBag.TotalIngresos).ToString("N2")) €</h4>
        </div>
    </div>
    <div class="col-4">
        <div class="card p-3 border-start border-danger border-4">
            <small class="text-muted fw-bold">GASTOS DEL PERIODO</small>
            <h4 class="text-danger fw-bold mb-0">@(((decimal)ViewBag.TotalGastos).ToString("N2")) €</h4>
        </div>
    </div>
    <div class="col-4">
        <div class="card p-3 border-start border-warning border-4">
            <small class="text-muted fw-bold">SALDO DEL PERIODO</small>
            <h4 class="fw-bold mb-0" style="color: var(--olivo-oscuro);">@(((decimal)ViewBag.Saldo).ToString("N2")) €</h4>
        </div>
    </div>
</div>

<!-- Buscador con Lupita + Historial de búsquedas recientes -->
<div class="card card-olivo p-3 mb-3 no-print">
    <div class="input-group">
        <span class="input-group-text bg-white border-end-0">🔍</span>
        <input type="text" id="buscadorReportes" class="form-control border-start-0" placeholder="Buscar registro por comunero, concepto, aceite, aceituna, factura, fecha o importe..." />
        <button type="button" class="btn btn-outline-secondary" onclick="limpiarBusqueda()">Limpiar</button>
    </div>
    <div id="historialReportes" class="d-flex flex-wrap align-items-center gap-1 mt-2 small"></div>
</div>

<!-- Tabla del Informe -->
<div class="card card-olivo">
    <div class="table-responsive">
        <table id="tablaReportes" class="table table-striped table-bordered align-middle mb-0 small">
            <thead style="background-color: #556b2f; color: white;">
                <tr>
                    <th>Fecha</th>
                    <th>Apartado</th>
                    <th>Concepto</th>
                    <th>Detalle / Comunero / Factura</th>
                    <th class="text-center">Litros</th>
                    <th class="text-end">Ingreso</th>
                    <th class="text-end">Gasto</th>
                    <th class="text-center no-print">Comprobante</th>
                    @if (!esSoloConsulta)
                    {
                        <th class="text-center no-print">Acción</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="@(esSoloConsulta ? 8 : 9)" class="text-center py-4 text-muted">No hay registros en el rango seleccionado.</td></tr>
                }
                else
                {
                    foreach (var m in Model)
                    {
                        <tr>
                            <td>@m.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@m.Apartado</td>
                            <td class="fw-bold">@m.Concepto</td>
                            <td>@(m.DetalleExtra ?? m.Factura ?? m.Notas ?? "-")</td>
                            <td class="text-center">@(m.Litros.HasValue ? m.Litros.Value.ToString("N2") + " L" : "-")</td>
                            <td class="text-end text-success fw-bold">@(m.Ingreso > 0 ? m.Ingreso.ToString("N2") + " €" : "-")</td>
                            <td class="text-end text-danger fw-bold">@(m.Gasto > 0 ? m.Gasto.ToString("N2") + " €" : "-")</td>
                            <td class="text-center no-print">
                                @if (!string.IsNullOrEmpty(m.RutaComprobante))
                                {
                                    <a href="@m.RutaComprobante" target="_blank" class="btn btn-sm btn-outline-success py-0 px-2" title="Ver factura o recibo adjunto">📎 Ver</a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            @if (!esSoloConsulta)
                            {
                                <td class="text-center no-print">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-controller="Movimientos" asp-action="Editar"
                                           asp-route-idApartado="@m.IdApartado"
                                           asp-route-idRegistro="@m.IdRegistro"
                                           class="btn btn-sm btn-outline-primary py-0 px-2">Editar</a>

                                        <form asp-controller="Movimientos" asp-action="Eliminar" method="post" class="d-inline"
                                              onsubmit="return confirm('¿Seguro que deseas eliminar este movimiento de @m.Concepto (@m.Fecha.ToString("dd/MM/yyyy"))? Esta acción no se puede deshacer.');">
                                            <input type="hidden" name="idApartado" value="@m.IdApartado" />
                                            <input type="hidden" name="idRegistro" value="@m.IdRegistro" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">Eliminar</button>
                                        </form>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
    <script>
        const perfilReportes = "@($"{Context.Session.GetInt32("IdUsuario") ?? 0}_{Context.Session.GetString("Rol") ?? "Anon"}")";
        const KEY_HIST_REP = "melera_hist_reportes_" + perfilReportes;
        const inputBuscar = document.getElementById("buscadorReportes");
        const contHistRep = document.getElementById("historialReportes");
        let timerHistRep;

        localStorage.removeItem("melera_hist_busqueda");
        localStorage.removeItem("melera_hist_busqueda_");

        function obtenerHistorialRep() {
            try { return JSON.parse(localStorage.getItem(KEY_HIST_REP) || "[]"); }
            catch { return []; }
        }

        function guardarHistorialRep(texto) {
            const limpio = texto.trim();
            if (limpio.length < 2) return;
            let lista = obtenerHistorialRep().filter(x => x.toLowerCase() !== limpio.toLowerCase());
            lista.unshift(limpio);
            if (lista.length > 6) lista = lista.slice(0, 6);
            localStorage.setItem(KEY_HIST_REP, JSON.stringify(lista));
            renderizarHistorialRep();
        }

        function renderizarHistorialRep() {
            if (!contHistRep) return;
            const lista = obtenerHistorialRep();
            if (lista.length === 0) { contHistRep.innerHTML = ""; return; }
            contHistRep.innerHTML = `<span class="text-muted me-1">Búsquedas recientes:</span>` +
                lista.map(item =>
                    `<button type="button" class="badge rounded-pill text-bg-light border text-dark" style="cursor:pointer;" onclick="aplicarHistorialRep('${item.replace(/'/g, "\\'")}')">${item}</button>`
                ).join("");
        }

        function aplicarHistorialRep(valor) {
            if (!inputBuscar) return;
            inputBuscar.value = valor;
            filtrarReportes(valor);
        }

        function filtrarReportes(valor) {
            const filtro = valor.toLowerCase().trim();
            document.querySelectorAll("#tablaReportes tbody tr").forEach(fila => {
                fila.style.display = fila.textContent.toLowerCase().includes(filtro) ? "" : "none";
            });
        }

        if (inputBuscar) {
            inputBuscar.addEventListener("input", function () {
                filtrarReportes(this.value);
                clearTimeout(timerHistRep);
                timerHistRep = setTimeout(() => guardarHistorialRep(this.value), 900);
            });
        }

        function limpiarBusqueda() {
            if (inputBuscar) {
                inputBuscar.value = "";
                filtrarReportes("");
            }
            localStorage.removeItem(KEY_HIST_REP);
            renderizarHistorialRep();
        }

        // Exportación nativa a Excel (.xlsx real sin alertas)
        function exportarTablaExcel() {
            const tablaOriginal = document.getElementById("tablaReportes").cloneNode(true);
            tablaOriginal.querySelectorAll(".no-print").forEach(el => el.remove());

            const wb = XLSX.utils.table_to_book(tablaOriginal, { sheet: "Libro Diario" });
            const fecha = new Date().toISOString().slice(0, 10);
            XLSX.writeFile(wb, `Informe_Cortijo_La_Melera_${fecha}.xlsx`);
        }

        document.addEventListener("DOMContentLoaded", renderizarHistorialRep);
    </script>
}
